# Copy to .env.local and fill in values from the Supabase dashboard:
#   URL: Connect button (or Project Settings → Data API) — base URL only, no /rest/v1/
#   Key: Project Settings → API Keys → Publishable key (never the secret key)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_your-key
# Base URL used for public survey links and QR codes (no trailing slash).
VITE_PUBLIC_SITE_URL=http://localhost:5173

# Only for `npm run verify:db` (not bundled into the app — no VITE_ prefix).
INSTRUCTOR_EMAIL=you@example.edu
INSTRUCTOR_PASSWORD=your-instructor-password
